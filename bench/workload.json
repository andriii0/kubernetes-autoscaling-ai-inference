{
  "request": {
    "model": "qwen2.5:0.5b",
    "prompt": "Explain what a container is in three short sentences.",
    "stream": false,
    "keep_alive": -1,
    "options": {
      "num_predict": 64,
      "num_ctx": 1024,
      "num_thread": 2,
      "temperature": 0,
      "seed": 42
    }
  },
  "timeout_seconds": 30,
  "graceful_stop_seconds": 35,
  "time_unit_seconds": 10,
  "preallocated_vus": 50,
  "max_vus": 100,
  "burst_stages": [
    {
      "name": "low-before",
      "seconds": 120,
      "target": "low"
    },
    {
      "name": "rise",
      "seconds": 1,
      "target": "peak"
    },
    {
      "name": "peak",
      "seconds": 300,
      "target": "peak"
    },
    {
      "name": "fall",
      "seconds": 1,
      "target": "low"
    },
    {
      "name": "low-after",
      "seconds": 360,
      "target": "low"
    }
  ],
  "thresholds": {
    "error_rate": 0.01,
    "dropped_starts": 0
  },
  "main_protocol": {
    "version": "1.1",
    "primary_p95_ms": 5000,
    "sensitivity_p95_ms": 10000,
    "low_rate": 2,
    "peak_rate": 8,
    "steady_seconds": 300,
    "observer_interval_seconds": 5,
    "idle_seconds": 60,
    "warmup_timeout_seconds": 120,
    "fixed_post_seconds": 10,
    "hpa_post_seconds": 300
  }
}
