{
  "schemaVersion": "architect.diagram-snapshot.v1",
  "architecture": {
    "schemaVersion": "architect.canonical.v1",
    "diagram": {
      "id": "3be9d52c-97d6-437a-a310-f2202dd169af",
      "name": "C2 - Containers",
      "description": "Expands C1 experiment system: local UI, Python workbench, k6, evidence and deployed serving/metric processes. C3 expands the Python workbench. Both custom comparison policies use Envoy.",
      "sections": [
        {
          "id": "24dfa7ff-4916-4994-b678-2677e00e27be",
          "name": "External Kubernetes platform",
          "comment": "Built-in platform controllers and resource metrics.",
          "parentId": null
        },
        {
          "id": "82c4bcb6-c134-4dcb-89a2-f58b30a0d0ca",
          "name": "Experiment system / deployed workload",
          "comment": "Minikube inference namespace; all inference replicas share one host.",
          "parentId": null
        },
        {
          "id": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "name": "Experiment system / Windows host",
          "comment": "Owned tools and local saved evidence. Python workbench = several CLI processes, not a daemon cluster.",
          "parentId": null
        }
      ],
      "components": [
        {
          "id": "1899dd64-1214-472d-93e3-e71e1cb2d854",
          "name": "Inference Lab browser",
          "comment": "HTML / CSS / JavaScript. Browses saved results, plots and Notes; starts pilots or resumes main v1.1 only.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "2c4341ee-ccb1-4191-8eca-c0f48ebfc09f",
          "name": "Inference gateway",
          "comment": "Envoy. Routes requests to Ollama and exports active-request metrics plus request-ID access logs. Used by BOTH custom comparison arms.",
          "type": "CLASS",
          "sectionId": "82c4bcb6-c134-4dcb-89a2-f58b30a0d0ca",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "321668a6-6504-4c04-b6c5-2d9c83eaff62",
          "name": "Benchmark CLI",
          "comment": "Python bench CLI processes. Prepare, execute and collect controlled experiments; finalize per-run analysis. Custom comparison is launched from CLI. Components in C3.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "68bdfc62-5f2b-4cdd-ba11-e9f89a6b8f00",
          "name": "HPA controller",
          "comment": "CPU utilization or active-request Object metric drives desired replica count, bounded 1-3. Policies are mutually exclusive per run.",
          "type": "CLASS",
          "sectionId": "24dfa7ff-4916-4994-b678-2677e00e27be",
          "rows": [],
          "customTypeId": "4d3c0a23-7b59-4ddd-a442-5b4b6b4babc4"
        },
        {
          "id": "70919478-082d-4d48-9e82-8f07305f73d1",
          "name": "Offline analysis",
          "comment": "Python analysis CLIs. Replay saved evidence and generate comparison tables / plots. No traffic generation is needed for saved-result analysis.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "7ecf283a-6912-4733-b6f5-6d4d290e6c9b",
          "name": "Prometheus",
          "comment": "Scrapes Envoy active requests and sample timestamps. Metric source for request-based HPA, not benchmark CPU collection.",
          "type": "CLASS",
          "sectionId": "82c4bcb6-c134-4dcb-89a2-f58b30a0d0ca",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "915be889-f3de-4a37-8bf0-67bd058383df",
          "name": "Metrics Server",
          "comment": "Provides CPU Resource Metrics API to the CPU HPA. Observer CPU evidence comes directly from kubelet resource metrics.",
          "type": "CLASS",
          "sectionId": "24dfa7ff-4916-4994-b678-2677e00e27be",
          "rows": [],
          "customTypeId": "4d3c0a23-7b59-4ddd-a442-5b4b6b4babc4"
        },
        {
          "id": "b46e03d0-d5f4-449c-9893-5e1eeb0c7cc9",
          "name": "Ollama inference",
          "comment": "Qwen2.5:0.5b, CPU. Deployment fixed at 1 or 3 replicas, or HPA 1-3. Services route traffic; Ready does not guarantee a warmed model.",
          "type": "CLASS",
          "sectionId": "82c4bcb6-c134-4dcb-89a2-f58b30a0d0ca",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "c2812d29-b977-438c-90b5-fe11719a74bd",
          "name": "Lab HTTP server",
          "comment": "Python lab/server.py on loopback. Serves browser assets, saved results, plots and Notes; launches pilot or main-series child processes.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "da93542e-e188-4ab3-ae4c-821d9b3c3538",
          "name": "Kubernetes API",
          "comment": "kubectl operations, pod/deployment/HPA state, logs and kubelet /metrics/resource proxy used by benchmark observer.",
          "type": "CLASS",
          "sectionId": "24dfa7ff-4916-4994-b678-2677e00e27be",
          "rows": [],
          "customTypeId": "4d3c0a23-7b59-4ddd-a442-5b4b6b4babc4"
        },
        {
          "id": "e755d251-6144-49b3-ae7d-89febe97b806",
          "name": "k6 load generator",
          "comment": "Child process; inference.js sends nonstream requests. Compiled Go extension measures monotonic elapsed latency.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "e7e9b5aa-3b6c-451e-ab0a-5d804dcaedca",
          "name": "Prometheus Adapter",
          "comment": "Exposes Object metric via custom.metrics.k8s.io. HPA queries the metric associated with inference-gateway Service.",
          "type": "CLASS",
          "sectionId": "82c4bcb6-c134-4dcb-89a2-f58b30a0d0ca",
          "rows": [],
          "customTypeId": "5562f1bd-8706-4ca4-950a-e8d283f112ae"
        },
        {
          "id": "e94b5d7f-de5e-458c-bd03-fc2cb774db11",
          "name": "Local evidence files",
          "comment": "results/: archived inputs, manifests, request / cluster JSONL, CSV tables, PNG/SVG plots and editable notes.md.",
          "type": "CLASS",
          "sectionId": "f9d2c04a-d2e7-4798-91d3-5fb213cf813a",
          "rows": [],
          "customTypeId": "c8d01b94-c42d-4712-8949-1cebac6b632b"
        }
      ],
