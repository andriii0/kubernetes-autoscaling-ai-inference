    "schemaVersion": "architect.canonical.v1",
    "diagram": {
      "id": "d56e1114-e3c1-4391-a505-f91f5eb4e3ca",
      "name": "C3 - Python workbench components",
      "description": "Expands C2 Python workbench. UI control is limited to pilot/main; custom comparison uses CLI. C4 expands these responsibilities into complete owned code modules, classes and interfaces.",
      "sections": [
        {
          "id": "20b0141e-9e51-44b8-b82d-e44ddf712ff9",
          "name": "Python workbench / CLI experiment processes",
          "comment": "Drivers call shared lifecycle; experiment_lock excludes overlapping experiment runs.",
          "parentId": null
        },
        {
          "id": "2c347c0a-3b3d-4cc6-908f-b2b44d5a19df",
          "name": "Python workbench / lab HTTP process",
          "comment": "Browser API, saved data and launch controls.",
          "parentId": null
        },
        {
          "id": "53c691f1-aa75-4a90-bfdf-12cd925bcb44",
          "name": "Python workbench / offline analysis",
          "comment": "Saved records are checked independently of live cluster state.",
          "parentId": null
        }
      ],
      "components": [
        {
          "id": "28f8eea9-295f-4e5d-8d88-67c8ce66f36f",
          "name": "Analysis + comparisons",
          "comment": "analyze.py, summarize_main.py, analyze_custom_comparison.py. Collection validity and target outcomes are separate.",
          "type": "CLASS",
          "sectionId": "53c691f1-aa75-4a90-bfdf-12cd925bcb44",
          "rows": [],
          "customTypeId": "98f5e96b-bac0-41c0-9f6e-3ba5b23672d6"
        },
        {
          "id": "30ad26b3-e185-4d9c-80a3-5e73662f5992",
          "name": "Scaling lifecycle",
          "comment": "autoscaling.py Session + CustomSession. Prepare / enable / observe / restore CPU or request policy; keep logs and identity.",
          "type": "CLASS",
          "sectionId": "20b0141e-9e51-44b8-b82d-e44ddf712ff9",
          "rows": [],
          "customTypeId": "98f5e96b-bac0-41c0-9f6e-3ba5b23672d6"
        },
        {
          "id": "3ca02786-8ad4-427f-a35b-e38897b23d2c",
          "name": "Custom metric support",
          "comment": "custom_metric_run.Monitor, custom_metrics, check_custom_metric, custom_metric_stack. Clock, freshness, zero gate and gateway reconciliation.",
          "type": "CLASS",
          "sectionId": "20b0141e-9e51-44b8-b82d-e44ddf712ff9",
          "rows": [],
          "customTypeId": "98f5e96b-bac0-41c0-9f6e-3ba5b23672d6"
        },
        {
          "id": "42bb8179-d973-4467-ab1e-715322b3b715",
          "name": "Protocol preparation",
          "comment": "main_protocol.py + fixed_replicas.py. Fixed warmup, quiet baseline, input/config checks, scheduled windows and recovery.",
          "type": "CLASS",
          "sectionId": "20b0141e-9e51-44b8-b82d-e44ddf712ff9",
          "rows": [],
          "customTypeId": "98f5e96b-bac0-41c0-9f6e-3ba5b23672d6"
        },
        {
          "id": "4c9271d3-ba88-4d3d-9d29-259d0a77aa11",
          "name": "Notes repository",
          "comment": "lab/notes.py: revision-checked atomic notes.md writes; inherited parent Notes are read-only.",
